# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# MongoDB Atlas (cloud) — no local mongo. Get the SRV string from the Atlas cluster's Connect dialog.
MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/fleet?retryWrites=true&w=majority

# MQTT broker is AWS IoT Core (mTLS) — no local broker. Services connect with their X.509 certs
# from infra/iot/certs (provision with infra/iot/provision-vehicles.js and provision-backend.js).
# Get the endpoint with: aws iot describe-endpoint --endpoint-type iot:Data-ATS
IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com

# SQS-compatible queue (local ElasticMQ; real SQS endpoint in production)
SQS_ENDPOINT=http://localhost:9324
AWS_REGION=elasticmq
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
