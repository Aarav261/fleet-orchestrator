# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Every service, the simulator and the load generator load THIS single file (dotenv,
# from the repo root). The code has no fallback defaults — every value lives here.
# Experiment dials (bottom two sections) are overridable per run on the CLI, e.g.
#   N=800 node simulator/fleet-simulator.js   (CLI wins over .env)

# ── MongoDB Atlas (cloud) — shared by ingest, dispatch, dashboard ─────────────
# SRV string from the Atlas cluster's Connect dialog.
MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/fleet?retryWrites=true&w=majority

# ── AWS IoT Core (MQTT broker, mTLS) — the only broker, no local Mosquitto ─────
# Endpoint: aws iot describe-endpoint --endpoint-type iot:Data-ATS
# Cert dir holds per-vehicle (veh-####) + backend (svc-*) certs, provisioned by
# infra/iot/provision-vehicles.js and provision-backend.js. Path is relative to the repo root.
IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
IOT_CERT_DIR=infra/iot/certs

# ── SQS: real AWS SQS (credentials from ~/.aws/credentials or the ECS LabRole) ─
SQS_QUEUE_NAME=rider-requests
AWS_REGION=us-east-1
# Local ElasticMQ instead: uncomment these three and set AWS_REGION=elasticmq.
# SQS_ENDPOINT=http://localhost:9324
# AWS_ACCESS_KEY_ID=x
# AWS_SECRET_ACCESS_KEY=x

# ── Service ports (host). Avoid 3000/3001 if taken by other processes ─────────
INGEST_PORT=3011
DISPATCH_PORT=3002
DASHBOARD_PORT=3010

# ── Dispatch tuning: SQS poll loops per replica (set 1 for exp2/exp4 contrast) ─
DISPATCH_WORKERS=4

# ── Rider load generator target ───────────────────────────────────────────────
DISPATCH_URL=http://localhost:3002

# ── Simulator dials (baseline; override per run) ──────────────────────────────
N=50
RATE_MS=1000
EDGE_FILTER=on
DURATION_S=0
CITY_LAT=-37.8136
CITY_LON=144.9631

# ── Rider load dials (baseline; override per run) ─────────────────────────────
RPS=5
BURST=1
BURST_AT=9999
DURATION=60
