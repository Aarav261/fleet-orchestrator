{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": [
        "arn:aws:iot:us-east-1:203377390456:client/svc-ingest-*",
        "arn:aws:iot:us-east-1:203377390456:client/svc-dispatch-*",
        "arn:aws:iot:us-east-1:203377390456:client/svc-nodered"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:us-east-1:203377390456:topicfilter/$share/ingest/fleet/telemetry/*",
        "arn:aws:iot:us-east-1:203377390456:topicfilter/fleet/telemetry/*",
        "arn:aws:iot:us-east-1:203377390456:topicfilter/fleet/dispatch/*",
        "arn:aws:iot:us-east-1:203377390456:topicfilter/fleet/alerts/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:us-east-1:203377390456:topic/fleet/telemetry/*",
        "arn:aws:iot:us-east-1:203377390456:topic/fleet/dispatch/*",
        "arn:aws:iot:us-east-1:203377390456:topic/fleet/alerts/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:us-east-1:203377390456:topic/fleet/dispatch/*",
        "arn:aws:iot:us-east-1:203377390456:topic/fleet/alerts/*"
      ]
    }
  ]
}
